{
  "name": "devbroom",
  "version": "1.0.0",
  "description": "A disk cleanup tool for developers - finds node_modules, build output, caches and logs across your projects and sweeps them to the Recycle Bin.",
  "keywords": [
    "electron",
    "disk-cleanup",
    "node-modules",
    "developer-tools",
    "cleanup",
    "react"
  ],
  "main": "electron/main.js",
  "author": "Uddhav Bhardwaj (https://github.com/bhrdwjuddhv)",
  "license": "MIT",
  "homepage": "https://github.com/bhrdwjuddhv/DevBroom",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bhrdwjuddhv/DevBroom.git"
  },
  "bugs": {
    "url": "https://github.com/bhrdwjuddhv/DevBroom/issues"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "test": "node electron/scanner.test.js && node electron/ai.test.js"
  },
  "dependencies": {
    "@fontsource/instrument-sans": "^5.3.0",
    "electron-store": "^11.0.2",
    "node-llama-cpp": "^3.20.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "trash": "^10.1.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "vite": "^8.2.2"
  }
}
